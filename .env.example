# 이 파일을 복사해 로컬 개발용 .env.local 을 만드세요:  cp .env.example .env.local
# 실제 키 값은 여기에 넣지 말고(.env.example 은 git에 커밋됨), .env.local 또는
# 배포 플랫폼(Vercel)의 Environment Variables 에만 넣으세요.

# Google Gemini API 키 (필수) — 서버 사이드에서만 사용되며 브라우저에 노출되지 않습니다.
# 무료 발급: https://aistudio.google.com/apikey (신용카드 불필요)
GEMINI_API_KEY=

# 기본 모델 (선택). 요청에서 모델을 지정하지 않으면 이 값을 사용합니다.
# 미설정 시 앱 기본값 gemini-2.5-flash 를 사용합니다.
GEMINI_MODEL=
